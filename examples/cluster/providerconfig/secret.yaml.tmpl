apiVersion: v1
kind: Secret
metadata:
  name: noderings-creds
  namespace: crossplane-system
type: Opaque
stringData:
  # A NodeRings service account token. Optional keys: organization_id,
  # endpoint, max_retries, requests_per_second, http_timeout.
  credentials: |
    {
      "token": "{{ .TOKEN }}"
    }
